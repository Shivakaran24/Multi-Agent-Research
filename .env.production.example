# Copy to .env.production and fill in. Use random values; never commit .env.production.
SITE_ADDRESS=research.example.com
CORS_ORIGINS=["https://research.example.com"]
ALLOWED_HOSTS=["research.example.com"]

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
TAVILY_API_KEY=
# python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=
# Optional legacy token for scripts only
RESEARCH_API_TOKEN=
POSTGRES_PASSWORD=
ALLOW_REGISTRATION=false

MAX_ITERATIONS=1
INITIAL_QUESTIONS=4
SEARCH_RESULTS_PER_QUERY=4
MAX_CONCURRENT_RUNS=1
MAX_PARALLEL_GRAPH_TASKS=1
GROQ_MAX_OUTPUT_TOKENS=3500
GROQ_SUMMARY_MAX_TOKENS=1024