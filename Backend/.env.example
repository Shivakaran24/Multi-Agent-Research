APP_ENV=development
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_EVAL_MODEL=
# Optional second Groq model used when the main one is rate limited, e.g. llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=
TAVILY_API_KEY=
# Signs login sessions. Leave empty in development (sessions then end on server restart);
# REQUIRED in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=720
ALLOW_REGISTRATION=true
# Optional legacy shared token for scripts (at least 32 characters). Normal users sign in instead.
RESEARCH_API_TOKEN=
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
MAX_ITERATIONS=1
INITIAL_QUESTIONS=4
SEARCH_RESULTS_PER_QUERY=4
MAX_CONCURRENT_RUNS=1
MAX_PARALLEL_GRAPH_TASKS=1
GROQ_MAX_OUTPUT_TOKENS=3500
GROQ_SUMMARY_MAX_TOKENS=1024
# Characters of each search result the researcher reads
SOURCE_EXCERPT_CHARS=1200
# Per-user cost controls (0 disables the daily cap)
MAX_RUNS_PER_USER_PER_DAY=20
MAX_ACTIVE_RUNS_PER_USER=1
# Password-reset email. Without SMTP_HOST the reset link is printed to the server log in development.
APP_BASE_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Optional showcase account created at startup (see DEPLOY.md)
DEMO_EMAIL=
DEMO_PASSWORD=

# Require new accounts to confirm their email before researching (needs SMTP_* in production).
REQUIRE_EMAIL_VERIFICATION=true

# Model tokens each user may spend per rolling 24 hours (0 = unlimited).
MAX_TOKENS_PER_USER_PER_DAY=0
# Recurring research: schedules per user, and whether the background scheduler runs.
MAX_SCHEDULES_PER_USER=2
SCHEDULER_ENABLED=true
# Source filtering: only pages from the last day|week|month|year (empty = any age).
# SEARCH_TIME_RANGE=year
# BLOCKED_DOMAINS and PREFERRED_DOMAINS take JSON lists, e.g. ["example.com"].

# Optional hardening
# INVITE_CODES=code1,code2   (comma-separated; registration then requires one)
# ADMIN_EMAILS=you@example.com   (these accounts see the Admin usage page)
# CLAIM_CHECK=true   (second pass marks claims the sources do not support; costs one extra model call)
